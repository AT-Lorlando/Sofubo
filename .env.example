# Provided by Koya at launch in production (never committed as .env)
TZ=UTC
PORT=3333
HOST=localhost
NODE_ENV=development
LOG_LEVEL=info
APP_KEY=
SESSION_DRIVER=cookie
# Optional: send cookies over HTTPS only (default: true in production).
# Set to false if the app is served over plain HTTP (e.g. through the VPN).
COOKIE_SECURE=

# Secret in the tablet start URL: http://<host>/?token=<DISPLAY_TOKEN>
DISPLAY_TOKEN=
# Password of the /admin page
ADMIN_PASSWORD=
# Optional: photos folder (default: storage/photos). Back it up.
PHOTOS_DIR=
