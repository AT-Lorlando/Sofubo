<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta http-equiv="refresh" content="300">
<title>Sofubo</title>
<style>
html,body{margin:0;height:100%;background:#000;color:#ddd;font-family:sans-serif;overflow:hidden}
.frame{height:92%;text-align:center}
.frame img{max-width:100%;max-height:100%;position:relative;top:50%;transform:translateY(-50%);-webkit-transform:translateY(-50%)}
.date{height:8%;font-size:3.5vh;text-align:center;line-height:8vh}
.empty{padding-top:40vh;text-align:center;font-size:4vh}
</style>
</head>
<body>
@if(photo)
<div class="frame"><img src="{{ photo.url }}" alt=""></div>
<div class="date">{{ photo.date }}</div>
@else
<div class="empty">Pas encore de photo</div>
@end
</body>
</html>
